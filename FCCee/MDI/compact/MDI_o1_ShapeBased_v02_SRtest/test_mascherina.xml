<lccdd>


    <!--  Definition of the used visualization attributes    -->
    <display>
        <vis name="SRMasksVis" alpha="0.0" r="0.0" g="1.0" b="0.0" showDaughters="true" visible="false"/>
    </display>

    <detectors>

      <!--
      <detector name="MyDetector" type="DD4hep_GdmlDetector" vis="SRMasksVis" >
	<gdmlFile ref="newSRmasks.gdml"/>
	<parent name="world"/>
	<position x="0*mm" y="0*mm" z="0*mm"/>
	<rotation x="0*degree" y="0*degree" z="0*degree"/>
      </detector>
      -->

      <detector name="EllipticalMask_W_R" type="DD4hep_GdmlDetector" vis="SRMasksVis">
	<parent name="world"/>
	<gdmlFile ref="newSRmasks.gdml" physvol="ellipticalMask_upstream_pv_R"/>
	<position x="-1.95015*cm" y="0*cm" z="130*cm"/>
	<rotation x="0*degree" y="-0.015*rad" z="0*degree"/>
      </detector>

      <detector name="EllipticalMask_Cu_R" type="DD4hep_GdmlDetector" vis="SRMasksVis">
        <parent name="world"/>
        <gdmlFile ref="newSRmasks.gdml" physvol="ellipticalMask_Cu_upstream_pv_R"/>
