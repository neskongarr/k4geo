      </detector>

      <detector name="EllipticalMask_Vacuum_L" type="DD4hep_GdmlDetector" vis="SRMasksVis">
	<parent name="world"/>
        <gdmlFile ref="newSRmasks.gdml" physvol="ellipticalMask_Vacuum_upstream_pv_L"/>
