        <rotation x="0*degree" y="-0.015*rad" z="0*degree"/>
      </detector>

      <detector name="EllipticalMask_Vacuum_R" type="DD4hep_GdmlDetector" vis="SRMasksVis">
        <parent name="world"/>
        <gdmlFile ref="newSRmasks.gdml" physvol="ellipticalMask_Vacuum_upstream_pv_R"/>
	<position x="-1.95015*cm" y="0*cm" z="130*cm"/>
	<rotation x="0*degree" y="-0.015*rad" z="0*degree"/>
      </detector>


      <detector name="EllipticalMask_W_L" type="DD4hep_GdmlDetector" vis="SRMasksVis">
        <parent name="world"/>
        <gdmlFile ref="newSRmasks.gdml" physvol="ellipticalMask_upstream_pv_L"/>
        <position x="-1.95015*cm" y="0*cm" z="-130*cm"/>
        <rotation x="0*degree" y="0.015*rad" z="0*degree"/>
